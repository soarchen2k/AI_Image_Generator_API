# Classic ComfyUI HTTP API on the LAN host
COMFYUI_URL=http://192.168.3.75:8188

# Leave blank to use COMFYUI_URL for the v2 attempt as well.
# For a separate self-hosted Comfy API v2 proxy, set this to its address, e.g. http://127.0.0.1:8189
COMFYUI_V2_URL=

# Optional static bearer token. Keep the real value only in config/comfyui.env.
COMFYUI_API_TOKEN=

# Output directory for generated results. Leave blank to use the current working directory of the command.
# For each new topic, point this (or $env:COMFYUI_OUTPUT_DIR) at a topic subdirectory of the working
# directory, e.g. C:\Users\soarc\OneDrive\相册\AI 图片\<topic>. Use an absolute path.
# A process environment variable takes precedence over this file.
COMFYUI_OUTPUT_DIR=
COMFYUI_POLL_INTERVAL=2
COMFYUI_WAIT_TIMEOUT=1800
COMFYUI_API=auto

# Optional generation HTTP API (default: 127.0.0.1:8190).
COMFYUI_IMAGE_API_HOST=127.0.0.1
COMFYUI_IMAGE_API_PORT=8190

# Required when binding the image API to an address other than localhost/127.0.0.1.
# Use a private value in config/comfyui.env; never commit a real token.
COMFYUI_IMAGE_API_TOKEN=

# Optional URL origin for response_format=url. For 0.0.0.0 binds, set a client-reachable address.
COMFYUI_IMAGE_API_PUBLIC_URL=
